# Browser-safe Supabase settings (these are included in the client bundle).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only Netlify Function settings. NEVER prefix the secret with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# Optional: restrict API CORS to your deployed site origin.
APP_ORIGIN=https://YOUR_SITE.netlify.app
